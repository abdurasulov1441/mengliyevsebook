# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development
# Public address of this server (used in links, e.g. https://etimolog.uz)
PUBLIC_URL=http://localhost:3000
# Where the database and files are stored
DATA_DIR=data

# Long random string (required in production): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=90

# Administrator for the web panel (/admin). Created/updated on start.
ADMIN_PHONE=998900000000
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Administrator

# GetSMS.uz (login/password from GetSMS support). Empty login = dry run:
# codes are printed in the server log instead of being sent.
# GetSMS only accepts requests from whitelisted IPs: send them the server IP.
SMS_LOGIN=
SMS_PASSWORD=
SMS_NICKNAME=
SMS_TEMPLATE=Mengliyev's eBook: tasdiqlash kodi {code}. Kodni hech kimga bermang.

# Development only: this code is accepted for any phone (ignored in production)
DEV_OTP_CODE=111111
# App store review account: this phone always accepts this code
TEST_PHONE=
TEST_CODE=

# LibreOffice for old .doc/.rtf/.odt (auto-detected; the Docker image has it)
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

MAX_BOOK_MB=100
MAX_IMAGE_MB=10
CORS_ORIGINS=*
