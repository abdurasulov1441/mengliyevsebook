# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development
# Public address of this server (used in links, e.g. https://etimolog.uz)
PUBLIC_URL=http://localhost:3000
# Where the database and files are stored
DATA_DIR=data

# Long random string (required in production): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=90

# Numbers that become administrators after SMS login (comma separated)
ADMIN_PHONES=998900961704
# Web admin panel (/admin): phone + password. Created/updated on start.
ADMIN_PHONE=998900961704
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Administrator

# Platform defaults (the admin can change them in Settings)
PLATFORM_NAME=BookHub
COMMISSION_PERCENT=30
PAYOUT_MIN=50000

# Payments
# Demo button instead of real payment (development only, NEVER in production)
PAYMENTS_DEMO=false
# Payme (merchant cabinet -> endpoint: <PUBLIC_URL>/api/payments/payme, account field: order_id)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=true
# Click (prepare: <PUBLIC_URL>/api/payments/click/prepare, complete: .../click/complete)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Where Payme/Click return the user ({order} is replaced); default <PUBLIC_URL>/api/pay/return
PAYMENT_RETURN_URL=

# GetSMS.uz (login/password from GetSMS support). Empty login = dry run:
# codes are printed in the server log instead of being sent.
# GetSMS only accepts requests from whitelisted IPs: send them the server IP.
SMS_LOGIN=
SMS_PASSWORD=
SMS_NICKNAME=
SMS_TEMPLATE=BookHub: tasdiqlash kodi {code}. Kodni hech kimga bermang.

# Development only: this code is accepted for any phone (ignored in production)
DEV_OTP_CODE=111111
# App store review account: this phone always accepts this code
TEST_PHONE=
TEST_CODE=

# LibreOffice for old .doc/.rtf/.odt (auto-detected; the Docker image has it)
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

MAX_BOOK_MB=100
MAX_IMAGE_MB=10
CORS_ORIGINS=*
